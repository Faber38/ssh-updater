QMainWindow { background: #1e1f22; }
QToolBar { background: #2a2c31; border: 0; padding: 6px; }
QTableView, QTreeView#dockerHostTable { background: #232428; color: #ddd; gridline-color: #333; }
QHeaderView::section { background: #2a2c31; color: #ddd; padding: 6px; border: 0; }
QStatusBar { background: #2a2c31; color: #aaa; }
QPushButton { background: #2f3136; color: #eee; border-radius: 6px; padding: 6px 10px; }
QPushButton:hover { background: #3a3d45; }

/* QTreeView needs explicit grid painting; reuse the table grid colour. */
QTreeView#dockerHostTable { qproperty-gridColor: #333; }

/* Offline help uses the existing dark window/table colours. */
QDialog#helpDialog { background: #1e1f22; }
QTreeWidget#helpNavigation, QTextBrowser#helpContent {
    background: #232428;
    color: #ddd;
    border: 1px solid #333;
}
